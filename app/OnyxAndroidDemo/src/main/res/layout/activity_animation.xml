<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:id="@+id/activity_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <LinearLayout
            android:id="@+id/layout_function"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_start_animation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始翻页动画" />

            <Button
                android:id="@+id/button_toggle_alignment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="切换64位对齐" />

            <TextView
                android:id="@+id/text_alignment_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:text="当前状态：未对齐" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_function"
            android:layout_marginTop="10dp"
            android:text="此演示模拟电子书的垂直边缘翻页效果，不再使用弯曲效果，而是采用垂直边缘和阴影效果，使翻页更加清晰流畅。您可以点击'开始翻页动画'按钮，或从屏幕右侧边缘滑动来体验翻页效果。" />

        <!-- 使用自定义的PageCurlView实现书籍翻页效果 -->
        <com.android.onyx.demo.PageCurlView
            android:id="@+id/page_curl_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/text_description"
            android:layout_marginTop="10dp"
            android:background="@android:color/white" />

    </RelativeLayout>
</layout>